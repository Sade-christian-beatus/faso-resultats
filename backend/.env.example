# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080

# Base de données (nom du service docker-compose = "db")
DATABASE_URL=postgresql+asyncpg://faso:faso_secret@db:5432/faso_resultats

# Cache
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# Auth admin (JWT)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Profil candidat (plateforme) — docs/PROFIL_CANDIDAT_UNIFIE.md
# CANDIDAT_ENCRYPTION_KEY : clé Fernet pour le chiffrement au repos du CNIB/téléphone/date
# de naissance. Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANDIDAT_JWT_EXPIRE_MINUTES=43200
CANDIDAT_ENCRYPTION_KEY=change-me-in-production-with-a-real-fernet-key
CANDIDAT_HASH_PEPPER=change-me-in-production
CANDIDAT_OTP_EXPIRE_MINUTES=5
CANDIDAT_OTP_MAX_TENTATIVES=3

# Rate limiting
RATE_LIMIT_PUBLIC=30/minute
RATE_LIMIT_LOGIN=5/minute

# Stockage des fichiers uploadés
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
