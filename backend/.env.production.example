# Gabarit pour backend/.env.production — à copier puis compléter sur le
# serveur de démo. NE JAMAIS committer le fichier réel (backend/.env.production
# doit rester dans .gitignore, comme backend/.env).

# Application
ENVIRONMENT=production
# Domaine réel du site de démo, HTTPS obligatoire (Caddy le fournit) :
CORS_ORIGINS=https://demo.faso-resultats.votredomaine.bf

# Base de données (nom du service docker-compose = "db")
# POSTGRES_PASSWORD est lu par docker-compose.prod.yml pour le conteneur db —
# la même valeur doit apparaître ici ET dans le fichier .env à la racine
# (voir POSTGRES_PASSWORD ci-dessous dans le runbook de déploiement).
DATABASE_URL=postgresql+asyncpg://faso:CHANGER_CE_MOT_DE_PASSE@db:5432/faso_resultats

# Cache
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# Auth admin (JWT) — générer une vraie valeur, ne jamais garder le défaut :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Profil candidat (plateforme)
CANDIDAT_JWT_EXPIRE_MINUTES=43200
# CLÉ FERNET OBLIGATOIRE — À GÉNÉRER, JAMAIS RÉUTILISÉE ENTRE ENVIRONNEMENTS :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANDIDAT_ENCRYPTION_KEY=
# Générer une vraie valeur, ne jamais garder le défaut :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CANDIDAT_HASH_PEPPER=
CANDIDAT_OTP_EXPIRE_MINUTES=5
CANDIDAT_OTP_MAX_TENTATIVES=3

# Rate limiting — resserré par rapport au défaut dev pour un site
# véritablement public (ajuster si le pic de démonstration l'exige)
RATE_LIMIT_PUBLIC=30/minute
RATE_LIMIT_LOGIN=5/minute

# API B2B (Phase 4) — générer une vraie valeur même si l'API B2B n'est pas
# utilisée pendant la démo (l'app refuse de démarrer sinon) :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=

# Stockage des fichiers uploadés
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
