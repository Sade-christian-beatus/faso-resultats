# Ce projet ne lit pas de fichier .env au runtime — la config d'environnement
# passe par --dart-define (voir lib/config/env.dart et README.md). Ce fichier
# documente les valeurs possibles pour référence.

# ENV=dev (défaut) ou ENV=prod
ENV=dev

# Optionnel en dev : surcharge l'URL de l'API (défaut http://10.0.2.2:8000,
# l'alias localhost de la machine hôte vu depuis l'émulateur Android).
API_BASE_URL=http://10.0.2.2:8000
