# Production settings — copy to deploy/production.env (never committed, see
# .gitignore) and fill in every value. docs/DEPLOIEMENT.md explains each step.
#
# Generate random secrets with:   openssl rand -hex 32
# Generate the Fernet key with:   docker run --rm python:3.11-slim sh -c \
#   "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"

# Domain of the platform (DNS A record pointing to the server), without https://
DOMAINE=fasoresultats.bf

# Database password (hex only: it is embedded in a connection URL)
POSTGRES_PASSWORD=

# Secrets — the API refuses to start in production with the development defaults
JWT_SECRET_KEY=
CANDIDAT_HASH_PEPPER=
API_KEY_PEPPER=
# ⚠️ Keep a copy of this key OUTSIDE the server (sealed envelope, password manager):
# losing it makes the encrypted candidate data permanently unreadable.
CANDIDAT_ENCRYPTION_KEY=

# Contact shown to candidates for their data rights (CIL)
CANDIDAT_DPO_CONTACT_EMAIL=dpo@fasoresultats.bf

# API workers: about one per CPU core of the server
UVICORN_WORKERS=2

# Rate limiting (per visitor IP)
RATE_LIMIT_PUBLIC=30/minute
RATE_LIMIT_LOGIN=5/minute
